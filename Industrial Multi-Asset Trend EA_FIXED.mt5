//+------------------------------------------------------------------+
//|              Industrial Multi-Asset Trend EA                     |
//| Strategy: EMA + RSI + ADX + ATR                                  |
//| Timeframe: H1                                                    |
//| No Martingale / No Grid / No HFT                                 |
//+------------------------------------------------------------------+
#property strict
#property version   "1.10"

#include <Trade/Trade.mqh>

CTrade trade;

//==================================================================
// INPUT PARAMETERS
//==================================================================

//--- Strategy
input ENUM_TIMEFRAMES InpTimeframe = PERIOD_H1;

input int    InpFastEMA      = 20;
input int    InpSlowEMA      = 50;

input int    InpRSIPeriod    = 14;
input double InpRSIBuy       = 55.0;
input double InpRSISell      = 45.0;

input int    InpADXPeriod    = 14;
input double InpMinADX       = 20.0;

input int    InpATRPeriod    = 14;

//--- Risk Management
input double InpRiskPercent  = 1.0;

input double InpSL_ATR       = 2.0;
input double InpTP_ATR       = 3.0;

//--- Protection
input double InpDailyLossPct = 2.0;
input double InpMaxDDPct     = 25.0;

input int    InpCooldownBars = 3;

//--- Spread
input double InpMaxSpreadPoints = 50;

//--- Margin Safety
// Keep a small portion of free margin unused so orders are not rejected by margin checks.
input double InpMarginReservePct = 5.0;

//--- Trading
input ulong  InpMagicNumber  = 20260919;

//==================================================================
// INDICATOR HANDLES
//==================================================================

int hFastEMA = INVALID_HANDLE;
int hSlowEMA = INVALID_HANDLE;
int hRSI     = INVALID_HANDLE;
int hADX     = INVALID_HANDLE;
int hATR     = INVALID_HANDLE;

//==================================================================
// GLOBAL VARIABLES
//==================================================================

datetime lastBarTime = 0;
datetime lastTradeTime = 0;

double initialEquity = 0.0;
double dayStartEquity = 0.0;

int currentDay = -1;

//==================================================================
// INITIALIZATION
//==================================================================

int OnInit()
{
   trade.SetExpertMagicNumber(InpMagicNumber);
   trade.SetTypeFillingBySymbol(_Symbol);

   initialEquity = AccountInfoDouble(ACCOUNT_EQUITY);
   dayStartEquity = initialEquity;

   MqlDateTime dt;
   TimeToStruct(TimeCurrent(), dt);
   currentDay = dt.day;

   //--- EMA
   hFastEMA = iMA(
      _Symbol,
      InpTimeframe,
      InpFastEMA,
      0,
      MODE_EMA,
      PRICE_CLOSE
   );

   hSlowEMA = iMA(
      _Symbol,
      InpTimeframe,
      InpSlowEMA,
      0,
      MODE_EMA,
      PRICE_CLOSE
   );

   //--- RSI
   hRSI = iRSI(
      _Symbol,
      InpTimeframe,
      InpRSIPeriod,
      PRICE_CLOSE
   );

   //--- ADX
   hADX = iADX(
      _Symbol,
      InpTimeframe,
      InpADXPeriod
   );

   //--- ATR
   hATR = iATR(
      _Symbol,
      InpTimeframe,
      InpATRPeriod
   );

   if(
      hFastEMA == INVALID_HANDLE ||
      hSlowEMA == INVALID_HANDLE ||
      hRSI     == INVALID_HANDLE ||
      hADX     == INVALID_HANDLE ||
      hATR     == INVALID_HANDLE
   )
   {
      Print("ERROR: Failed to create indicator handles.");
      return INIT_FAILED;
   }

   Print("Industrial Multi-Asset Trend EA initialized.");

   return INIT_SUCCEEDED;
}

//==================================================================
// DEINITIALIZATION
//==================================================================

void OnDeinit(const int reason)
{
   if(hFastEMA != INVALID_HANDLE)
      IndicatorRelease(hFastEMA);

   if(hSlowEMA != INVALID_HANDLE)
      IndicatorRelease(hSlowEMA);

   if(hRSI != INVALID_HANDLE)
      IndicatorRelease(hRSI);

   if(hADX != INVALID_HANDLE)
      IndicatorRelease(hADX);

   if(hATR != INVALID_HANDLE)
      IndicatorRelease(hATR);
}

//==================================================================
// NEW BAR DETECTION
//==================================================================

bool IsNewBar()
{
   datetime currentBarTime =
      iTime(_Symbol, InpTimeframe, 0);

   if(currentBarTime == 0)
      return false;

   if(currentBarTime != lastBarTime)
   {
      lastBarTime = currentBarTime;
      return true;
   }

   return false;
}

//==================================================================
// DAILY RESET
//==================================================================

void CheckNewDay()
{
   MqlDateTime dt;
   TimeToStruct(TimeCurrent(), dt);

   if(dt.day != currentDay)
   {
      currentDay = dt.day;

      dayStartEquity =
         AccountInfoDouble(ACCOUNT_EQUITY);

      Print("New trading day. Daily equity reset.");
   }
}

//==================================================================
// DAILY LOSS PROTECTION
//==================================================================

bool DailyLossLimitReached()
{
   if(dayStartEquity <= 0)
      return false;

   double equity =
      AccountInfoDouble(ACCOUNT_EQUITY);

   double lossPct =
      ((dayStartEquity - equity)
      / dayStartEquity) * 100.0;

   if(lossPct >= InpDailyLossPct)
   {
      Print("Daily loss protection activated.");

      return true;
   }

   return false;
}

//==================================================================
// MAXIMUM DRAW DOWN PROTECTION
//==================================================================

bool MaximumDrawdownReached()
{
   if(initialEquity <= 0)
      return false;

   double equity =
      AccountInfoDouble(ACCOUNT_EQUITY);

   double ddPct =
      ((initialEquity - equity)
      / initialEquity) * 100.0;

   if(ddPct >= InpMaxDDPct)
   {
      Print("Maximum drawdown protection activated.");

      return true;
   }

   return false;
}

//==================================================================
// SPREAD FILTER
//==================================================================

bool SpreadIsSafe()
{
   double ask =
      SymbolInfoDouble(_Symbol, SYMBOL_ASK);

   double bid =
      SymbolInfoDouble(_Symbol, SYMBOL_BID);

   double spreadPoints =
      (ask - bid) / _Point;

   if(spreadPoints > InpMaxSpreadPoints)
   {
      Print("Spread too high: ",
            spreadPoints);

      return false;
   }

   return true;
}

//==================================================================
// POSITION CHECK
//==================================================================

bool HasOpenPosition()
{
   if(!PositionSelect(_Symbol))
      return false;

   ulong magic =
      (ulong)PositionGetInteger(
         POSITION_MAGIC
      );

   if(magic != InpMagicNumber)
      return false;

   return true;
}

//==================================================================
// COOLDOWN
//==================================================================

bool CooldownFinished()
{
   if(lastTradeTime == 0)
      return true;

   int barsPassed =
      iBarShift(
         _Symbol,
         InpTimeframe,
         lastTradeTime,
         false
      );

   if(barsPassed >= InpCooldownBars)
      return true;

   return false;
}

//==================================================================
// LOT CALCULATION
//==================================================================

//==================================================================
// VOLUME DIGITS
//==================================================================

int GetVolumeDigits(double volumeStep)
{
   if(volumeStep >= 1.0)
      return 0;
   if(volumeStep >= 0.1)
      return 1;
   if(volumeStep >= 0.01)
      return 2;
   if(volumeStep >= 0.001)
      return 3;

   return 4;
}

//==================================================================
// MARGIN-SAFE VOLUME
//==================================================================
// Reduce the requested volume when the account cannot afford the
// required margin. Uses OrderCalcMargin() so the calculation follows
// the current account/symbol margin model, including 1:1 leverage.

double LimitVolumeByMargin(
   ENUM_ORDER_TYPE orderType,
   double desiredVolume,
   double price
)
{
   double minVolume = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MIN);
   double maxVolume = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MAX);
   double volumeStep = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_STEP);

   if(minVolume <= 0 || maxVolume <= 0 || volumeStep <= 0)
      return 0;

   double freeMargin = AccountInfoDouble(ACCOUNT_MARGIN_FREE);
   if(freeMargin <= 0)
      return 0;

   double reserve = MathMax(0.0, MathMin(InpMarginReservePct, 50.0));
   double usableMargin = freeMargin * (1.0 - reserve / 100.0);

   if(usableMargin <= 0)
      return 0;

   desiredVolume = MathMin(desiredVolume, maxVolume);
   if(desiredVolume < minVolume)
      desiredVolume = minVolume;

   // First make sure the minimum allowed volume is affordable.
   double minMargin = 0.0;
   if(!OrderCalcMargin(orderType, _Symbol, minVolume, price, minMargin))
   {
      Print("OrderCalcMargin failed for minimum volume. Error=", GetLastError());
      return 0;
   }

   if(minMargin > usableMargin)
   {
      PrintFormat(
         "No affordable volume. MinLot=%.4f Margin=%.2f FreeMargin=%.2f UsableMargin=%.2f",
         minVolume, minMargin, freeMargin, usableMargin
      );
      return 0;
   }

   // Binary search for the largest affordable volume.
   double low = minVolume;
   double high = desiredVolume;

   for(int i = 0; i < 40; i++)
   {
      double mid = (low + high) * 0.5;
      double margin = 0.0;

      if(!OrderCalcMargin(orderType, _Symbol, mid, price, margin))
      {
         high = mid;
         continue;
      }

      if(margin <= usableMargin)
         low = mid;
      else
         high = mid;
   }

   double volume =
      MathFloor((low + 1e-12) / volumeStep) * volumeStep;

   if(volume < minVolume)
      return 0;

   if(volume > desiredVolume)
      volume = desiredVolume;

   // Final safety check after rounding to the broker's volume step.
   double finalMargin = 0.0;
   while(volume >= minVolume)
   {
      if(OrderCalcMargin(orderType, _Symbol, volume, price, finalMargin)
         && finalMargin <= usableMargin)
      {
         int volumeDigits = GetVolumeDigits(volumeStep);

         PrintFormat(
            "Margin-safe volume: requested=%.4f final=%.4f margin=%.2f free=%.2f reserve=%.1f%%",
            desiredVolume, volume, finalMargin, freeMargin, reserve
         );

         return NormalizeDouble(volume, volumeDigits);
      }

      volume -= volumeStep;
      volume = NormalizeDouble(volume, GetVolumeDigits(volumeStep));
   }

   return 0;
}

//==================================================================
// LOT CALCULATION
//==================================================================

double CalculateLotSize(
   double stopDistance,
   ENUM_ORDER_TYPE orderType,
   double entryPrice
)
{
   if(stopDistance <= 0 || entryPrice <= 0)
      return 0;

   double equity =
      AccountInfoDouble(ACCOUNT_EQUITY);

   double riskMoney =
      equity * InpRiskPercent / 100.0;

   double tickSize =
      SymbolInfoDouble(
         _Symbol,
         SYMBOL_TRADE_TICK_SIZE
      );

   double tickValue =
      SymbolInfoDouble(
         _Symbol,
         SYMBOL_TRADE_TICK_VALUE
      );

   if(tickSize <= 0 || tickValue <= 0)
      return 0;

   double moneyPerLot =
      (stopDistance / tickSize)
      * tickValue;

   if(moneyPerLot <= 0)
      return 0;

   // Original risk-based volume.
   double requestedVolume =
      riskMoney / moneyPerLot;

   double minVolume =
      SymbolInfoDouble(
         _Symbol,
         SYMBOL_VOLUME_MIN
      );

   double maxVolume =
      SymbolInfoDouble(
         _Symbol,
         SYMBOL_VOLUME_MAX
      );

   double volumeStep =
      SymbolInfoDouble(
         _Symbol,
         SYMBOL_VOLUME_STEP
      );

   if(minVolume <= 0 || maxVolume <= 0 || volumeStep <= 0)
      return 0;

   if(requestedVolume < minVolume)
      requestedVolume = minVolume;

   if(requestedVolume > maxVolume)
      requestedVolume = maxVolume;

   requestedVolume =
      MathFloor(
         requestedVolume / volumeStep
      ) * volumeStep;

   if(requestedVolume < minVolume)
      requestedVolume = minVolume;

   int volumeDigits = GetVolumeDigits(volumeStep);

   requestedVolume = NormalizeDouble(
      requestedVolume,
      volumeDigits
   );

   // Critical fix: make the risk-based lot compatible with available margin.
   return LimitVolumeByMargin(
      orderType,
      requestedVolume,
      entryPrice
   );
}

//==================================================================
// MAIN TICK FUNCTION
//==================================================================

void OnTick()
{
   CheckNewDay();

   //--- Only evaluate signals on a new candle
   if(!IsNewBar())
      return;

   //--- Protection
   if(DailyLossLimitReached())
      return;

   if(MaximumDrawdownReached())
      return;

   //--- Spread
   if(!SpreadIsSafe())
      return;

   //--- Existing position
   if(HasOpenPosition())
      return;

   //--- Cooldown
   if(!CooldownFinished())
      return;

   //================================================================
   // INDICATOR DATA
   //================================================================

double fastEMA[];
double slowEMA[];
double rsi[];
double adx[];
double atr[];

   ArraySetAsSeries(fastEMA, true);
   ArraySetAsSeries(slowEMA, true);
   ArraySetAsSeries(rsi, true);
   ArraySetAsSeries(adx, true);
   ArraySetAsSeries(atr, true);

   if(
      CopyBuffer(
         hFastEMA,
         0,
         1,
         2,
         fastEMA
      ) < 2
   )
      return;

   if(
      CopyBuffer(
         hSlowEMA,
         0,
         1,
         2,
         slowEMA
      ) < 2
   )
      return;

   if(
      CopyBuffer(
         hRSI,
         0,
         1,
         2,
         rsi
      ) < 2
   )
      return;

   if(
      CopyBuffer(
         hADX,
         0,
         1,
         2,
         adx
      ) < 2
   )
      return;

   if(
      CopyBuffer(
         hATR,
         0,
         1,
         2,
         atr
      ) < 2
   )
      return;

   //--- Last completed candle
   double closePrice =
      iClose(
         _Symbol,
         InpTimeframe,
         1
      );

   if(closePrice <= 0)
      return;

   //================================================================
   // BUY CONDITION
   //================================================================

   bool buySignal =
      fastEMA[0] > slowEMA[0] &&
      closePrice > slowEMA[0] &&
      rsi[0] > InpRSIBuy &&
      adx[0] > InpMinADX &&
      atr[0] > 0;

   //================================================================
   // SELL CONDITION
   //================================================================

   bool sellSignal =
      fastEMA[0] < slowEMA[0] &&
      closePrice < slowEMA[0] &&
      rsi[0] < InpRSISell &&
      adx[0] > InpMinADX &&
      atr[0] > 0;

   //================================================================
   // BUY
   //================================================================

   if(buySignal)
   {
      double ask =
         SymbolInfoDouble(
            _Symbol,
            SYMBOL_ASK
         );

      double slDistance =
         atr[0] * InpSL_ATR;

      double tpDistance =
         atr[0] * InpTP_ATR;

      double sl =
         ask - slDistance;

      double tp =
         ask + tpDistance;

      double lot =
         CalculateLotSize(
            slDistance,
            ORDER_TYPE_BUY,
            ask
         );

      if(lot <= 0)
         return;

      if(
         trade.Buy(
            lot,
            _Symbol,
            ask,
            sl,
            tp,
            "Industrial EA BUY"
         )
      )
      {
         uint retcode = trade.ResultRetcode();

         if(retcode == TRADE_RETCODE_DONE ||
            retcode == TRADE_RETCODE_DONE_PARTIAL ||
            retcode == TRADE_RETCODE_PLACED)
         {
            lastTradeTime = TimeCurrent();

            Print(
               "BUY opened. Lot=",
               lot,
               " SL=",
               sl,
               " TP=",
               tp,
               " Retcode=",
               retcode
            );
         }
         else
         {
            Print(
               "BUY request rejected. Retcode=",
               retcode,
               " Description=",
               trade.ResultRetcodeDescription()
            );
         }
      }
      else
      {
         Print(
            "BUY request failed. Retcode=",
            trade.ResultRetcode(),
            " Description=",
            trade.ResultRetcodeDescription()
         );
      }

      return;
   }

   //================================================================
   // SELL
   //================================================================

   if(sellSignal)
   {
      double bid =
         SymbolInfoDouble(
            _Symbol,
            SYMBOL_BID
         );

      double slDistance =
         atr[0] * InpSL_ATR;

      double tpDistance =
         atr[0] * InpTP_ATR;

      double sl =
         bid + slDistance;

      double tp =
         bid - tpDistance;

      double lot =
         CalculateLotSize(
            slDistance,
            ORDER_TYPE_SELL,
            bid
         );

      if(lot <= 0)
         return;

      if(
         trade.Sell(
            lot,
            _Symbol,
            bid,
            sl,
            tp,
            "Industrial EA SELL"
         )
      )
      {
         uint retcode = trade.ResultRetcode();

         if(retcode == TRADE_RETCODE_DONE ||
            retcode == TRADE_RETCODE_DONE_PARTIAL ||
            retcode == TRADE_RETCODE_PLACED)
         {
            lastTradeTime = TimeCurrent();

            Print(
               "SELL opened. Lot=",
               lot,
               " SL=",
               sl,
               " TP=",
               tp,
               " Retcode=",
               retcode
            );
         }
         else
         {
            Print(
               "SELL request rejected. Retcode=",
               retcode,
               " Description=",
               trade.ResultRetcodeDescription()
            );
         }
      }
      else
      {
         Print(
            "SELL request failed. Retcode=",
            trade.ResultRetcode(),
            " Description=",
            trade.ResultRetcodeDescription()
         );
      }

      return;
   }
}
//+------------------------------------------------------------------+